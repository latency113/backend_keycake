{
  "name": "app",
  "version": "1.0.50",
  "module": "src/index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "bun env:dev:dc && bun run --watch src/index.ts",
    "start": "bun run dist/index.js",
    "prepare": "husky install",
    "build": "bun run bun.config.mjs",
    "test:ci": "vitest",
    "commit": "cz",
    "cz": "lint-staged && cz",
    "lint:fix": "eslint --fix .",
    "lint": "eslint",
    "dotenvx": "dotenvx",
    "env:dev:dc": "dotenvx decrypt -f .env",
    "env:dev:ec": "dotenvx encrypt .env",
    "dotenvx:build": "dotenvx run -- sh -c 'bun build'",
    "dotenvx:example": "bun env:dev:dc && bun run dev",
    "env:all:dc": "bun env:dev:dc && bun env:uat:dc && bun env:prod:dc",
    "env:all:ec": "bun env:dev:ec && bun env:uat:ec && bun env:prod:ec",
    "dotenvx:dev": "dotenvx run -- bun dev",
    "dotenvx:start": "dotenvx run -- bun start",
    "prisma:generate": "prisma generate --schema=./prisma/schema",
    "prisma:push": "prisma db push --schema=./prisma/schema",
    "prisma:pull": "prisma db pull --schema=./prisma/schema",
    "prisma:migrate": "prisma migrate dev --schema=./prisma/schema",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=./prisma/schema",
    "prisma:studio": "prisma studio --schema=./prisma/schema",
    "prisma:reset": "prisma migrate reset --schema=./prisma/schema"
  },
  "dependencies": {
    "@antfu/eslint-config": "^4.16.2",
    "@dotenvx/dotenvx": "^1.45.2",
    "@elysiajs/cors": "^1.3.3",
    "@elysiajs/jwt": "^1.3.1",
    "@elysiajs/swagger": "^1.3.1",
    "@prisma/client": "^6.11.1",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.0.1",
    "elysia": "latest",
    "eslint": "^9.30.1",
    "exceljs": "^4.4.0",
    "zod": "^3.25.73"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "bun-types": "latest",
    "commitizen": "^4.3.1",
    "commitlint-config-gitmoji": "^2.3.1",
    "cz-customizable": "^7.4.0",
    "husky": "^8.0.0",
    "prisma": "^6.11.1",
    "vitest": "^3.2.4",
    "zod-prisma-types": "^3.2.4"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": "./cz.config.cjs"
    }
  }
}
